# Copy this file to .env and fill in the real password.
# Do not commit or share .env.
XC_DB_HOST=10.164.62.206
XC_DB_PORT=3306
XC_DB_DATABASE=biz
XC_DB_USER=bizreader
XC_DB_PASSWORD=put_real_password_here
XC_DB_CONNECT_TIMEOUT=8
XC_DB_READ_TIMEOUT=20
XC_DB_WRITE_TIMEOUT=20

# SQLite remote service
SQLITE_REMOTE_API_TOKEN=change_me
SQLITE_REMOTE_DB_PATH=F:\python\zonghe\service\urldata.db
SQLITE_REMOTE_HOST=0.0.0.0
SQLITE_REMOTE_PORT=5004
SQLITE_REMOTE_READ_ONLY=1
SQLITE_REMOTE_ENABLE_WRITE=0
SQLITE_REMOTE_MAX_ROWS=500
SQLITE_REMOTE_ALLOW_ANONYMOUS=0

# Message push MySQL service
MESSAGE_PUSH_MYSQL_HOST=127.0.0.1
MESSAGE_PUSH_MYSQL_PORT=3306
MESSAGE_PUSH_MYSQL_USER=change_me
MESSAGE_PUSH_MYSQL_PASSWORD=change_me
MESSAGE_PUSH_MYSQL_DATABASE=zonghe_service

# 辅料领退料明细（客户机 Oracle）
AUXILIARY_ORACLE_HOST=10.164.62.71
AUXILIARY_ORACLE_PORT=1521
AUXILIARY_ORACLE_SERVICE=TIMMS
AUXILIARY_ORACLE_CONNECT_MODE=service
AUXILIARY_ORACLE_USER=MES_ST
AUXILIARY_ORACLE_PASSWORD=change_me
AUXILIARY_ORACLE_DSN=
AUXILIARY_TRANSFERLOGG_VIEW=V_TRANSFERLOGG
AUXILIARY_TRANSFERLOGG_DATE_COLUMN=BGNDATE
AUXILIARY_TRANSFERLOGG_TYPE_COLUMN=TYPEDESC
AUXILIARY_TRANSFERLOGG_DEFAULT_TYPE=辅料出库
AUXILIARY_TRANSFERLOGG_DEFAULT_ORDER=desc
AUXILIARY_TRANSFERLOGG_MAX_ROWS=500

# 客户现场灯控服务
FLASK_SECRET_KEY=replace_with_a_long_random_value
LIGHT_CONTROL_BASE_URL=http://192.168.30.151:8888
LIGHT_CONTROL_PASSWORD=7887
LIGHT_CONTROL_UNLOCK_TTL_SECONDS=1800
LIGHT_CONTROL_TIMEOUT_SECONDS=8

# 待处理记录模块
PENDING_RECORD_DELETE_PASSWORD=7887
# PENDING_RECORD_DB_PATH=F:\python\zonghe\service\data\pending_records.db

# 仓储扫码报表（兼容现有东集 PDA 和 Windows 读码器客户端）
# 可选共享密钥；启用后 PDA、读码器和报表页面需填写相同密钥。
# 最多 256 位无空格 ASCII 字符。留空时适用于受控现场内网。
WAREHOUSE_API_KEY=
# 默认沿用独立扫码服务的数据目录：Windows %LOCALAPPDATA%\WarehouseScanService
# Linux ~/.local/share/warehouse-scan-service；目录内文件名为 scan-events.sqlite3。
# 建议正式部署指定项目之外的绝对路径，避免更换运行账号后读到不同的数据。
# WAREHOUSE_SCAN_DATA_DIR=D:\ServiceData\WarehouseScan
